<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="{{ csp|safe }}">
<meta name="referrer" content="strict-origin-when-cross-origin">
<title>{{ d.lead.headline }} | Carbon Energy Nexus</title>
<meta name="description" content="{{ desc }}">
<meta name="robots" content="index, follow, max-image-preview:large">
<link rel="canonical" href="{{ url }}">
{% if cfg.google_site_verification %}<meta name="google-site-verification" content="{{ cfg.google_site_verification }}">{% endif %}
{% if cfg.bing_site_verification %}<meta name="msvalidate.01" content="{{ cfg.bing_site_verification }}">{% endif %}
<meta property="og:type" content="article">
<meta property="og:site_name" content="Carbon Energy Nexus">
<meta property="og:title" content="{{ d.lead.headline }}">
<meta property="og:description" content="{{ desc }}">
<meta property="og:url" content="{{ url }}">
<meta property="og:image" content="https://carbonenergynexus.com/social/{{ d.date }}.png">
<meta property="og:image:width" content="1080"><meta property="og:image:height" content="1350">
<meta property="article:published_time" content="{{ published }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ d.lead.headline }}">
<meta name="twitter:description" content="{{ desc }}">
<meta name="twitter:image" content="https://carbonenergynexus.com/social/{{ d.date }}.png">
<link rel="icon" type="image/svg+xml" href="{{ root }}brand/cen-icon.svg">
<link rel="apple-touch-icon" href="{{ root }}brand/cen-icon-180.png">
<link rel="alternate" type="application/rss+xml" title="Carbon Energy Nexus" href="{{ root }}feed.xml">
<link rel="preload" href="{{ root }}assets/fonts/source-serif-4-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ root }}assets/style.css?v={{ v }}">
{% if cfg.ga_id %}<script async src="https://www.googletagmanager.com/gtag/js?id={{ cfg.ga_id }}"></script><script src="{{ root }}assets/ga.js?v={{ v }}" data-id="{{ cfg.ga_id }}"></script>{% endif %}
<script type="application/ld+json">{{ ld|safe }}</script>
</head>
<body>
{% include "header.html.j2" %}
<main id="main">
<section class="lead">
 <div class="wrap">
  <p class="dateline">{{ d.date_long }}<span class="ed">Edition {{ d.edition }}</span>{% if archived %}<a href="{{ root }}">Today's edition</a>{% endif %}</p>
  <div class="lead-grid">
   <article class="lead-story">
    <p class="lane"><span class="chip kick">{{ d.lead.kicker }}</span></p>
    <h1>{{ d.lead.headline }}</h1>
    <p class="dek">{{ d.lead.dek }}</p>
    {% for p in d.lead.body %}<p>{{ p }}</p>{% endfor %}
    <p class="src">Sources: {% for s in d.lead.sources %}<a href="{{ s.url }}" rel="noopener">{{ s.name }}</a>{% if not loop.last %}; {% endif %}{% endfor %}</p>
   </article>
   <aside class="triad" aria-label="How this story moves through the nexus">
    <h2>Through the nexus</h2>
    <div class="leg el"><h3>Electrons</h3><p>{{ d.lead.nexus.electrons }}</p></div>
    <div class="leg mo"><h3>Molecules</h3><p>{{ d.lead.nexus.molecules }}</p></div>
    <div class="leg po"><h3>Pore space</h3><p>{{ d.lead.nexus.pore }}</p></div>
    {% if d.lead.nexus.water %}<div class="leg wa"><h3>Water</h3><p>{{ d.lead.nexus.water }}</p></div>{% endif %}
   </aside>
  </div>
  <div class="use">
   <h2>Use it</h2>
   <dl>{% for u in d.lead.use %}<div><dt>{{ u.who }}</dt><dd>{{ u.text }}</dd></div>{% endfor %}</dl>
  </div>
 </div>
</section>

<section class="signals" aria-label="The numbers that matter today">
 <div class="wrap">
  <h2 class="sh">The numbers</h2>
  <div class="sig-grid">{% for s in d.signals %}
   <div class="sig c{{ loop.index0 % 4 }}"><p class="sig-l">{{ s.label }}</p><p class="sig-v">{{ s.value }}</p><p class="sig-n">{{ s.note }}</p><p class="sig-s"><a href="{{ s.source.url }}" rel="noopener">{{ s.source.name }}</a></p></div>{% endfor %}
  </div>
 </div>
</section>

<section class="briefs">
 <div class="wrap">
  <h2 class="sh">The brief</h2>
  {% for b in d.briefs %}
  <article class="brief" id="{{ b.id }}">
   <p class="lane"><span class="chip lane-{{ b.lane|lower }}">{{ b.lane }}</span></p>
   <h3>{{ b.headline }}</h3>
   <div class="brief-body">
    <p>{{ b.text }}</p>
    <dl class="use-sm">{% for u in b.use %}<div><dt>{{ u.who }}</dt><dd>{{ u.text }}</dd></div>{% endfor %}</dl>
   </div>
   <p class="src">Sources: {% for s in b.sources %}<a href="{{ s.url }}" rel="noopener">{{ s.name }}</a>{% if not loop.last %}; {% endif %}{% endfor %}</p>
  </article>
  {% endfor %}
 </div>
</section>

<section class="tracker" id="projects">
 <div class="wrap">
  <h2 class="sh">Project tracker</h2>
  <p class="intro">Tap a project name to open its official site. Where each project stands on our seven step ladder from announcement to operation. Stage is our reading of public filings and reports, not the developer's claim.</p>
  <ol class="ladder-key">{% for st in stages %}<li>{{ st }}</li>{% endfor %}</ol>
  <div class="projects">
  {% for p in d.tracker %}
   <div class="proj">
    <div class="proj-h">{% if p.sector %}<span class="tag sec-{{ p.sector|lower|replace(' ','-') }}">{{ p.sector }}</span>{% endif %}<h3>{% if p.url %}<a href="{{ p.url }}" rel="noopener">{{ p.name }} <span aria-hidden="true">&#8599;</span></a>{% else %}{{ p.name }}{% endif %}</h3><p>{{ p.where }}. {{ p.type }}.</p></div>
    <div class="ladder" role="img" aria-label="Stage {{ p.stage }} of 7: {{ stages[p.stage-1] }}">{% for i in range(1,8) %}<span class="{{ 'on' if i <= p.stage else '' }}{{ ' now' if i == p.stage else '' }}"></span>{% endfor %}</div>
    <p class="stage-name">{{ stages[p.stage-1] }}</p>
    <p class="last">{{ p.last }}. <a href="{{ p.source.url }}" rel="noopener">{{ p.source.name }}</a></p>
   </div>
  {% endfor %}
  </div>
 </div>
</section>

{% if d.minerals %}
<section class="minerals" id="minerals">
 <div class="wrap">
  <h2 class="sh">Critical minerals and mining</h2>
  <p class="intro">{{ d.minerals.intro }}</p>
  <div class="min-grid">
  {% for m in d.minerals["items"] %}
   <article class="mineral m{{ loop.index0 % 6 }}">
    <div class="elem"><span class="sym">{{ m.symbol }}</span><span class="ename">{{ m.name }}</span></div>
    <h3>{{ m.headline }}</h3>
    <p>{{ m.text }}</p>
    <p class="src">Sources: {% for x in m.sources %}<a href="{{ x.url }}" rel="noopener">{{ x.name }}</a>{% if not loop.last %}; {% endif %}{% endfor %}</p>
   </article>
  {% endfor %}
  </div>
 </div>
</section>
{% endif %}

{% if d.innovation %}
<section class="innovation" id="innovation">
 <div class="wrap">
  <h2 class="sh">Innovation watch</h2>
  <p class="intro">New science from universities and new technology from companies, with the original source one tap away.</p>
  <div class="inno-grid">
  {% for n in d.innovation %}
   <article class="inno">
    <p class="inno-top"><span class="tag k-{{ n.kind|lower|replace(' ','-') }}">{{ n.kind }}</span><span class="when">{{ n.date }}</span></p>
    <h3><a href="{{ n.url }}" rel="noopener">{{ n.name }}</a></h3>
    <p class="role">{{ n.org }}</p>
    <p>{{ n.text }}</p>
   </article>
  {% endfor %}
  </div>
 </div>
</section>
{% endif %}

<section class="two">
 <div class="wrap two-grid">
  <div>
   <h2 class="sh">Who said what</h2>
   {% for v in d.voices %}<div class="voice"><h3>{{ v.name }}</h3><p class="role">{{ v.role }}</p><p>{{ v.text }} <a href="{{ v.source.url }}" rel="noopener">{{ v.source.name }}</a></p></div>{% endfor %}
  </div>
  <div>
   <h2 class="sh">Worth reading</h2>
   {% for r in d.research %}<div class="paper"><h3><a href="{{ r.url }}" rel="noopener">{{ r.title }}</a></h3><p class="role">{{ r.by }}, {{ r.date }}</p><p>{{ r.text }}</p></div>{% endfor %}
  </div>
 </div>
</section>

<section class="dates" id="events">
 <div class="wrap">
  <h2 class="sh">Events and dates ahead</h2>
  {% if d.events %}
  <p class="intro">Conferences, deadlines and market dates across carbon, renewables, hydrogen, power and minerals. Tap any line for the official page or source.</p>
  <ul class="events">{% for e in d.events %}<li class="ev"><span class="ev-when">{{ e.when }}</span><span class="ev-body"><span class="tag t-{{ e.type|lower }}">{{ e.type }}</span> {% if e.url %}<a href="{{ e.url }}" rel="noopener">{{ e.what }}</a>{% else %}{{ e.what }}{% endif %}{% if e.where %}<span class="ev-where">{{ e.where }}</span>{% endif %}</span></li>{% endfor %}</ul>
  {% else %}
  <ul class="cal">{% for c in d.calendar %}<li><span>{{ c.when }}</span>{{ c.what }}</li>{% endfor %}</ul>
  <p class="src">Sources: {% for s in d.calendar_sources %}<a href="{{ s.url }}" rel="noopener">{{ s.name }}</a>{% if not loop.last %}; {% endif %}{% endfor %}</p>
  {% endif %}
  <div class="calc-promo">
   <div><h2>What is your footprint?</h2>
   <p>Estimate the energy use and carbon emissions of your household or company from your bills, fuel and travel, using published EPA and EIA factors. Every factor is shown with its source.</p></div>
   <a class="btn" href="{{ root }}calculator.html">Open the calculator</a>
  </div>
 </div>
</section>
</main>
{% include "footer.html.j2" %}
</body>
</html>
